{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":enableRenovate",
    ":enablePreCommit",
    ":ignoreModulesAndTests",
    ":preserveSemverRanges",
    ":pinAllExceptPeerDependencies",
    ":separateMultipleMajorReleases",
    ":separatePatchReleases",
    ":renovatePrefix",
    ":semanticPrefixFixDepsChoreOthers",
    ":rebaseStalePrs",
    ":prNotPending",
    ":disableRateLimiting",
    ":automergePatch",
    ":automergeMinor",
    ":automergeRequireAllStatusChecks",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes",
    ":gitSignOff",
    ":npm",
    ":docker",
    ":label(dependencies)",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":dependencyDashboard",
    ":timezone(Europe/Vienna)",
    "group:allApollographql",
    "group:kubernetesMonorepo",
    "group:googleapis",
    "group:linters",
    "group:typescript-eslintMonorepo",
    "security:minimumReleaseAgeNpm",
    "packages:eslint",
    "workarounds:typesNodeVersioning",
    "mergeConfidence:all-badges",
    "github>tyriis/renovate-config//github-actions/automerge-selected-major.json5",
  ],
  semanticCommits: "auto",
  stopUpdatingLabel: "stop-updating",
  dependencyDashboardTitle: ":robot: Renovate Dashboard",
  suppressNotifications: ["prIgnoreNotification"],
  packageRules: [
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["patch"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["minor"],
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
    {
      matchDepTypes: ["optionalDependencies"],
      addLabels: ["optional"],
    },
    {
      matchDepTypes: ["peerDependencies"],
      addLabels: ["peer"],
    },
    {
      matchDepTypes: ["devDependencies"],
      addLabels: ["dev"],
    },
    {
      matchManagers: ["pre-commit"],
      labels: ["dev", "pre-commit"],
    },
    {
      matchManagers: ["github-actions"],
      labels: ["dev", "github-actions"],
    },
    {
      // The Node.js runtime is pinned in four places: both Dockerfile stages,
      // .nvmrc and .mise.toml (CI reads .nvmrc via node-version-file). Group
      // them so one PR moves all of them to the same major.
      //
      // ignoreUnstable is what makes that PR complete: the docker datasource
      // knows no stability, but the node versioning Renovate uses for .nvmrc,
      // .mise.toml and engines only accepts a major once its LTS date has
      // passed (v26 LTS is 2026-10-28). Left at its default, the image bumps
      // alone and the other three follow weeks later.
      //
      // engines.node is deliberately not version-bumped: it is a compatibility
      // floor, not the version we run. ">=24.0.0" stays truthful while the code
      // runs on 24, and only joins this branch once the floor stops satisfying
      // the target.
      description: "Group the Node.js runtime pins into one PR per major",
      groupName: "Node.js",
      groupSlug: "nodejs",
      matchDatasources: ["docker", "node-version"],
      matchPackageNames: ["node"],
      // :separateMultipleMajorReleases is inherited from the presets above.
      separateMajorMinor: false,
      ignoreUnstable: false,
    },
  ],
}
